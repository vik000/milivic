---
---

<header class="main-header">
  <div class="header-container">
    <a href="/" class="logo">M&V</a>
    <button
      class="nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
    <nav class="nav-menu" id="nav-menu">
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/detalles">Evento</a></li>
        <li><a href="/viajar">Viajar</a></li>
        <li><a href="/sobre-tucuman">Tucumán</a></li>
        <li><a href="/argentina">Argentina</a></li>
        <li>
          <a href="/rsvp" class="rsvp-btn">
            <span class="desktop-label">Confirmar Asistencia</span>
            <span class="mobile-label">Confirmar</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .main-header {
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
    transition: background-color 0.3s ease;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    height: 80px;
  }

  .logo {
    font-size: 2rem;
    font-weight: 700;
    color: #333;
    text-decoration: none;
    font-family: "Playfair Display", serif, system-ui;
    letter-spacing: 1px;
  }

  /* Hamburger — hidden on desktop */
  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav-menu ul {
    list-style: none;
    display: flex;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-menu li a {
    text-decoration: none;
    color: #555;
    font-weight: 500;
    font-size: 1rem;
    font-family: "Inter", system-ui, sans-serif;
    transition: color 0.3s ease;
    position: relative;
  }

  .nav-menu li a:not(.rsvp-btn)::after {
    content: "";
    position: absolute;
    width: 0;
    height: 2px;
    bottom: -5px;
    left: 0;
    background-color: #d4af37;
    transition: width 0.3s ease;
  }

  .nav-menu li a:not(.rsvp-btn):hover::after {
    width: 100%;
  }

  .nav-menu li a:hover {
    color: #111;
  }

  .rsvp-btn {
    background-color: #d4af37;
    color: #fff !important;
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    transition: all 0.3s ease !important;
  }

  .rsvp-btn:hover {
    background-color: #c4a132;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
  }

  .mobile-label {
    display: none;
  }

  .desktop-label {
    display: inline;
  }

  @media (max-width: 768px) {
    .header-container {
      max-width: 100%;
      padding: 0.75rem 1.25rem;
      height: 64px;
    }

    .logo {
      font-size: 1.6rem;
    }

    /* Show the hamburger */
    .nav-toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 42px;
      height: 42px;
      padding: 0;
    }

    .nav-toggle .bar {
      display: block;
      width: 24px;
      height: 2px;
      margin: 0 auto;
      background: #333;
      border-radius: 2px;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    /* Morph into an X when open */
    .nav-toggle[aria-expanded="true"] .bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle[aria-expanded="true"] .bar:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle[aria-expanded="true"] .bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Collapsible panel below the header */
    .nav-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease;
    }

    .nav-menu.open {
      max-height: 75vh;
    }

    .nav-menu ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 0;
    }

    .nav-menu li {
      width: 100%;
    }

    .nav-menu li a:not(.rsvp-btn) {
      display: block;
      padding: 0.95rem 1.5rem;
      font-size: 1.05rem;
    }

    /* No underline animation in the stacked menu */
    .nav-menu li a:not(.rsvp-btn)::after {
      display: none;
    }

    .rsvp-btn {
      display: block;
      margin: 0.6rem 1.5rem 0.9rem;
      text-align: center;
      padding: 0.85rem 1rem;
      font-size: 1.05rem;
      white-space: nowrap;
    }

    .desktop-label {
      display: none;
    }

    .mobile-label {
      display: inline;
    }
  }
</style>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const menu = document.getElementById("nav-menu");

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove("open");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Abrir menú");
  }

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    });

    // Close when a link is tapped (handles same-page anchors too)
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Close when tapping outside the header
    document.addEventListener("click", (e) => {
      if (
        menu.classList.contains("open") &&
        !menu.contains(e.target) &&
        !toggle.contains(e.target)
      ) {
        closeMenu();
      }
    });
  }
</script>
