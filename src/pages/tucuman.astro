---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="tucuman-page">
        <section class="content-card">
            <div class="info-column">
                <h1>Tucumán</h1>
                <p>
                    Aquí añadiremos información útil sobre la zona,
                    recomendaciones de alojamiento, transporte y cualquier
                    detalle práctico para los invitados.
                </p>

                <h2>Cómo llegar</h2>
                <p>
                    Podéis llegar en avión al Aeropuerto Internacional Teniente
                    Benjamín Matienzo o en autobús desde otras ciudades
                    cercanas.
                </p>

                <h2>Alojamiento</h2>
                <p>
                    Más adelante añadiremos una lista de hoteles recomendados y
                    zonas donde alojarse.
                </p>
            </div>

            <div class="map-column">
                <iframe
                    title="Mapa de Tucumán"
                    src="https://www.google.com/maps?q=Tucumán,+Argentina&output=embed"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                >
                </iframe>
            </div>
        </section>
    </main>
</Layout>

<style>
    .tucuman-page {
        min-height: calc(100vh - 80px);
        padding: 3rem 2rem;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        background: #f8f6f2;
    }

    .content-card {
        width: 100%;
        max-width: 1200px;
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 2rem;
        background: white;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .info-column h1 {
        font-family: "Playfair Display", serif;
        font-size: 3rem;
        margin-top: 0;
        margin-bottom: 1.5rem;
        color: #222;
    }

    .info-column h2 {
        font-family: "Playfair Display", serif;
        font-size: 1.5rem;
        margin-top: 2rem;
        margin-bottom: 0.5rem;
        color: #333;
    }

    .info-column p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #555;
        margin: 0;
    }

    .map-column {
        min-height: 500px;
    }

    .map-column iframe {
        width: 100%;
        height: 100%;
        min-height: 500px;
        border: 0;
        border-radius: 18px;
    }

    @media (max-width: 900px) {
        .content-card {
            grid-template-columns: 1fr;
        }

        .info-column h1 {
            font-size: 2.4rem;
        }

        .map-column,
        .map-column iframe {
            min-height: 380px;
        }
    }
</style>
