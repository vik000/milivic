---
import Layout from "../layouts/Layout.astro";
import bgImage from "../assets/background2.png";
import kiwiImage from "../assets/kiwi.png";
import miliVicImage from "../assets/milivic.png";
---

<Layout>
  <main class="hero-section">
    <img src={bgImage.src} alt="Background" class="bg-image" />

    <div class="content-overlay">
      <h1 class="hero-text">Mili y Vic se casan</h1>
      <p class="subtitle">27/3/27 ¡Acompáñanos en nuestro día especial!</p>

      <div class="image-gallery">
        <img
          src={miliVicImage.src}
          alt="Mili y Vic"
          class="floating-img img-1"
        />
        <img src={kiwiImage.src} alt="Kiwi" class="floating-img img-2" />
      </div>
    </div>
  </main>
</Layout>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 80px); /* Fill the screen minus header */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    filter: brightness(0.7); /* Darkens background to make text readable */
  }

  .content-overlay {
    position: relative;
    text-align: center;
    color: white;
    z-index: 1;
    padding: 2rem;
    max-width: 1200px;
    width: 100%;
  }

  .hero-text {
    font-size: 5rem;
    font-family: "Playfair Display", serif, system-ui;
    margin-bottom: 0.5rem;
    text-shadow: 2px 4px 10px rgba(0, 0, 0, 0.5);
    animation: fadeInDown 1s ease-out;
  }

  .subtitle {
    font-size: 1.8rem;
    font-weight: 300;
    margin-bottom: 4rem;
    text-shadow: 1px 2px 5px rgba(0, 0, 0, 0.5);
    animation: fadeInUp 1s ease-out 0.5s both;
  }

  .image-gallery {
    position: relative;
    height: 400px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .floating-img {
    width: auto;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.4s ease;
    animation: fadeIn 1.5s ease-out 1s both;
  }

  .img-1 {
    height: 380px;
    z-index: 2;
  }

  .img-2 {
    position: absolute;
    height: 160px;
    left: calc(50% + 120px);
    bottom: 20px;
    z-index: 3;
    transform: rotate(8deg);
  }

  .img-1:hover {
    transform: scale(1.05) translateY(-5px);
    z-index: 10;
  }

  .img-2:hover {
    transform: rotate(0deg) scale(1.1) translateY(-5px);
    z-index: 10;
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .hero-text {
      font-size: 3rem;
    }
    .subtitle {
      font-size: 1.2rem;
    }
    .image-gallery {
      height: auto;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .img-1 {
      height: 280px;
      transform: rotate(-3deg);
      margin-bottom: 1rem;
    }
    .img-2 {
      position: relative;
      height: 120px;
      left: auto;
      bottom: auto;
      transform: rotate(3deg);
      align-self: center;
      margin-left: 120px;
      margin-top: -60px;
    }
  }
</style>
